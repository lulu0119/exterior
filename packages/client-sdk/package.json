{
  "name": "@exterioragentprotocol/client-sdk",
  "version": "0.1.0-beta.1",
  "description": "App-owned Code Mode catalogs and REPLs for applications that serve tools over MCP.",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulu0119/exterior.git",
    "directory": "packages/client-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./codemode": {
      "types": "./dist/codemode/index.d.ts",
      "import": "./dist/codemode/index.js"
    },
    "./codemode/executor": {
      "types": "./dist/codemode/executor.d.ts",
      "import": "./dist/codemode/executor.js"
    },
    "./codemode/mcp": {
      "types": "./dist/codemode/mcp.d.ts",
      "import": "./dist/codemode/mcp.js"
    },
    "./codemode/typescript": {
      "types": "./dist/codemode/typescript.d.ts",
      "import": "./dist/codemode/typescript.js"
    },
    "./codemode/typescript-catalog": {
      "types": "./dist/codemode/typescript-catalog.d.ts",
      "import": "./dist/codemode/typescript-catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && printf '%s\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' > dist/.npmignore",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "ts-blank-space": "^0.9.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "typescript": "^5.9.2 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
