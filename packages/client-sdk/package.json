{
  "name": "@exterioragentprotocol/client-sdk",
  "version": "0.1.0-beta.1",
  "description": "App-owned Code Mode and on-demand MCP Skills for Exterior clients.",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulu0119/exterior.git",
    "directory": "packages/client-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./codemode": {
      "types": "./dist/codemode/index.d.ts",
      "import": "./dist/codemode/index.js"
    },
    "./codemode/worker": {
      "types": "./dist/codemode/browser.worker.d.ts",
      "import": "./dist/codemode/browser.worker.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/copy-wasm.mjs && printf '%s\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' 'test-support/' > dist/.npmignore",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.5.2",
    "@modelcontextprotocol/server": "2.4.0",
    "birpc": "^4.2.0",
    "fuse.js": "^7.5.0",
    "quickjs-wasi": "3.6.2",
    "unstorage": "^1.17.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
