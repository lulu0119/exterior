{
  "name": "@exterioragentprotocol/sdk",
  "version": "0.1.0-beta.1",
  "description": "Exterior Agent Protocol for clients, devices, and relays: reach an ACP agent on a machine its user owns.",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulu0119/exterior.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/react": {
      "types": "./dist/client/react.d.ts",
      "import": "./dist/client/react.js"
    },
    "./codemode": {
      "types": "./dist/codemode/index.d.ts",
      "import": "./dist/codemode/index.js"
    },
    "./codemode/executor": {
      "types": "./dist/codemode/executor.d.ts",
      "import": "./dist/codemode/executor.js"
    },
    "./codemode/mcp": {
      "types": "./dist/codemode/mcp.d.ts",
      "import": "./dist/codemode/mcp.js"
    },
    "./codemode/typescript": {
      "types": "./dist/codemode/typescript.d.ts",
      "import": "./dist/codemode/typescript.js"
    },
    "./codemode/typescript-catalog": {
      "types": "./dist/codemode/typescript-catalog.d.ts",
      "import": "./dist/codemode/typescript-catalog.js"
    },
    "./device": {
      "types": "./dist/device/index.d.ts",
      "import": "./dist/device/index.js"
    },
    "./relay": {
      "types": "./dist/relay/index.d.ts",
      "import": "./dist/relay/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && printf '%s\n' '*.test.js' '*.test.js.map' '*.test.d.ts' '*.test.d.ts.map' '*.tsbuildinfo' > dist/.npmignore",
    "prepublishOnly": "pnpm run build",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "oauth4webapi": "^3.8.8",
    "quickjs-emscripten-core": "0.32.0",
    "ts-blank-space": "^0.9.0",
    "valibot": "^1.5.0",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19",
    "typescript": "^5.9.2 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.18.1",
    "jsdom": "^30.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
